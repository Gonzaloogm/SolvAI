{
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "plugins": [
    "react-hooks"
  ],
  "rules": {
    "no-undef": "error",
    "react-hooks/rules-of-hooks": "error"
  }
}
