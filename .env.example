# ============================================================
# SolvAI — environment variables
# Copy to .env (and backend/.env when running the API outside Docker).
# Never commit real values. In production these live in GCP Secret Manager.
# ============================================================

# ── Core ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/solvai
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]

# ── Security ─────────────────────────────────────────────────
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
# Fernet key for stored provider credentials (required):
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Shared secret for the X-Admin-Key header on /admin endpoints
ADMIN_KEY=

# ── AI ───────────────────────────────────────────────────────
# Use a key from a GCP project with billing; the free tier caps at ~20 requests/day
GEMINI_API_KEY=

# ── Billing (Stripe) ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_BILLING_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_BUSINESS_PRICE_ID=price_...
STRIPE_REPORT_UNLOCK_PRICE_ID=price_...

# ── Data sources ─────────────────────────────────────────────
# Stripe and PayPal users connect with their own keys from the UI.
PAYPAL_ENV=sandbox            # sandbox | live
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:8000/data-sources/xero/callback
XERO_WEBHOOK_KEY=
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=
BELVO_ENV=sandbox

# ── Infrastructure ───────────────────────────────────────────
RESEND_API_KEY=
GCP_BUCKET_NAME=solvai-documents-eu

# ── Frontend (frontend/.env.local) ───────────────────────────
# VITE_API_BASE_URL=http://localhost:8000
