# Copy to deploy/.env.prod on the VM and fill in. Never commit the real file.

# ── Host ─────────────────────────────────────────────────────
# Public hostname pointing at the VM. Without a domain, use sslip.io:
# VM IP 203.0.113.7  ->  DOMAIN=203-0-113-7.sslip.io
DOMAIN=
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# ── Security ─────────────────────────────────────────────────
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ADMIN_KEY=

# ── AI ───────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_UNDERWRITER_MODEL=gemini-2.5-flash
GEMINI_LIGHT_MODEL=gemini-3.5-flash-lite

# ── Data sources ─────────────────────────────────────────────
PAYPAL_ENV=sandbox

# ── Billing: PayPal Subscriptions (SolvAI's own merchant app) ─
PAYPAL_BILLING_CLIENT_ID=
PAYPAL_BILLING_SECRET=
PAYPAL_PRO_PLAN_ID=
PAYPAL_BUSINESS_PLAN_ID=
PAYPAL_WEBHOOK_ID=

# ── Billing: Stripe (optional for the demo) ──────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BILLING_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
