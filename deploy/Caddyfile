# DOMAIN comes from deploy/.env.prod. Caddy obtains and renews the Let's Encrypt
# certificate automatically (for "localhost" it uses its own local CA).
{$DOMAIN} {
	encode zstd gzip

	# API and WebSocket (/api/ws/terminal/...), prefix stripped before reaching FastAPI
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# React single-page app
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
